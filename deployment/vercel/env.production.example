# Copy these into Vercel Project Settings > Environment Variables.
# Do not commit real secrets.

# Public asset base. Use a Cloudflare R2 custom domain, not r2.dev for production.
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.example.com/tanga/v2026-06-06

# Voice mode visible to browser code.
# Keep "recorder" if the current POC voice path is still active.

# Server-only OpenAI transcription configuration.
OPENAI_API_KEY=replace_me
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_TIMEOUT_MS=12000
TRANSCRIBE_MAX_AUDIO_SECONDS=12

# Local Whisper values are development-only. Leave unset in production.

# Optional Sentry.
NEXT_PUBLIC_SENTRY_DSN=replace_me_or_leave_blank_for_internal_pilot
SENTRY_AUTH_TOKEN=replace_me_or_leave_blank_for_internal_pilot
SENTRY_ORG=replace_me
SENTRY_PROJECT=tanga-presentation

# Optional auth gate for customer preview.
DEMO_ACCESS_PASSWORD=replace_me

# Cesium ion token is not part of the USD 100 production plan.
# Keep unset unless licensing and budget are approved.
# NEXT_PUBLIC_CESIUM_ION_TOKEN=

