# Core LFS types
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text

# Specific large files
public/texture_rgb_8192.png filter=lfs diff=lfs merge=lfs -text
public/height.bin filter=lfs diff=lfs merge=lfs -text
public/BlockModel.geojson filter=lfs diff=lfs merge=lfs -text

# All other small assets (png, jpg, json, geojson, kmz) are regular files

# These bounded presentation rasters ship with their metadata. Vercel's Git
# integration does not hydrate LFS pointers; each is smaller than 6 MB.
public/survey_*_hires.bin -filter -diff -merge -text
public/terrain_context_512.bin -filter -diff -merge -text
public/resource_blocks_v1.bin -filter -diff -merge -text
